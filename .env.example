# Local development (workers on your machine, Postgres + Redis from deploy/docker-compose.yml)
DATABASE_URL=postgresql://albion:albion@localhost:5432/albion_kills
REDIS_URL=redis://localhost:6379

# --- OVH VM production (/home/ubuntu/ingest/.env) ---
# DATABASE_URL=postgresql://albion:PASSWORD@127.0.0.1:5432/albion_kills?sslmode=require
# REDIS_URL=redis://127.0.0.1:6379
# INGEST_API_SECRET=strong-random-secret
# DISABLED_REGIONS=asia
# INGEST_API_PORT=3001

# Optional tuning (defaults are fine)
# DATABASE_USE_POOLER=false
# DATABASE_POOL_MAX=5

# JOBS_SOURCE is set by systemd — optional in .env for local dev only
