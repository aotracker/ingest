# Local development (workers on your machine, Postgres + Redis from client/docker-compose.yml)
DATABASE_URL=postgresql://albion:albion@localhost:5432/albion_kills
REDIS_URL=redis://localhost:6379

# --- OVH VM production ---
# DATABASE_URL=postgresql://albion:PASSWORD@127.0.0.1:5432/albion_kills?sslmode=require
# REDIS_URL=redis://127.0.0.1:6379

DATABASE_USE_POOLER=false
DATABASE_POOL_MAX=5
DISABLED_REGIONS=asia

# Label shown on /status (optional)
JOBS_SOURCE=worker

# HTTP API for Vercel client job triggers
INGEST_API_PORT=3001
INGEST_API_SECRET=change-me-in-production
