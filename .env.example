# Local development (workers on your machine, Postgres + Redis from deploy/docker-compose.yml)
DATABASE_URL=postgresql://albion:albion@localhost:5432/albion_kills
REDIS_URL=redis://localhost:6379

# --- OVH VM production (/home/ubuntu/ingest/.env) ---
# DATABASE_URL=postgresql://albion:PASSWORD@127.0.0.1:5432/albion_kills?sslmode=require
# REDIS_URL=redis://127.0.0.1:6379
# INGEST_API_SECRET=strong-random-secret
# DISABLED_REGIONS=
# INGEST_API_PORT=3001

# Twitch Helix app token (live poll + VOD attach). Same app as the client admin preview.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# YouTube Data API key (player YouTube seed import). Same key as the client.
# YOUTUBE_API_KEY=

# Optional tuning (defaults are fine)
# DATABASE_USE_POOLER=false
# DATABASE_POOL_MAX=3
# INGEST_DEBUG=1

# JOBS_SOURCE is set by systemd — optional in .env for local dev only

# --- Discord bot (OVH VM only; never set the bot token on Vercel) ---
# Kill switch: 1 = bot process + notify jobs + guild catch-up. Unset or 0 = fully off.
# DISCORD_ENABLED=0
# DISCORD_BOT_TOKEN=
# DISCORD_CLIENT_ID=
# DISCORD_PUBLIC_KEY=
# DISCORD_DEV_GUILD_ID=  # optional; Discord server snowflake (Copy Server ID), for instant command updates in that server
# DISCORD_SNAPSHOT_CDN=https://cdn.aotracker.net/snapshots
# ITEM_ICON_CDN=https://cdn.aotracker.net/item-icons
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
