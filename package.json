{
  "name": "ingest",
  "private": true,
  "description": "Background workers and VM maintenance — never deploy to Vercel",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=.env scripts/start.ts",
    "worker": "tsx --env-file=.env src/worker.ts all",
    "worker:process": "tsx --env-file=.env src/worker.ts process",
    "worker:process:loop": "tsx --env-file=.env src/worker.ts process",
    "worker:scheduler": "tsx --env-file=.env src/worker.ts scheduler",
    "worker:scheduler:loop": "tsx --env-file=.env src/worker.ts scheduler",
    "jobs:process": "npm run worker:process",
    "jobs:process:loop": "npm run worker:process:loop",
    "jobs:ingest": "tsx --env-file=.env scripts/run-ingest-once.ts",
    "jobs:ingest:loop": "npm run worker:scheduler:loop",
    "jobs:health": "tsx --env-file=.env scripts/run-health-once.ts",
    "jobs:health:loop": "npm run worker:scheduler:loop",
    "jobs:queue-top-guilds": "tsx --env-file=.env scripts/queue-top-guilds-from-events.ts",
    "db:retain": "tsx --env-file=.env scripts/db-retain.ts",
    "db:evict-battle-details": "tsx --env-file=.env scripts/db-retain.ts",
    "db:apply-api-sync-health": "tsx --env-file=.env scripts/db/apply-api-sync-health-schema.ts",
    "db:apply-alliance-battles": "tsx --env-file=.env scripts/db/apply-alliance-battles-schema.ts",
    "db:apply-kill-fame-idx": "tsx --env-file=.env scripts/db/apply-kill-fame-idx.ts",
    "db:apply-battle-detail-unavailable": "tsx --env-file=.env scripts/db/apply-battle-detail-unavailable-schema.ts",
    "db:apply-battle-detail-eviction": "tsx --env-file=.env scripts/db/apply-battle-detail-eviction-schema.ts",
    "db:apply-ops-events": "tsx --env-file=.env scripts/db/apply-ops-events-schema.ts",
    "db:apply-api-request-log-details": "tsx --env-file=.env scripts/db/apply-api-request-log-details-schema.ts",
    "db:apply-battles-and-participants-idx": "tsx --env-file=.env scripts/db/apply-battles-and-participants-idx.ts",
    "db:apply-guild-hour-stats": "tsx --env-file=.env scripts/db/apply-guild-hour-stats.ts",
    "db:apply-discord-bot": "tsx --env-file=.env scripts/db/apply-discord-bot.ts",
    "db:apply-kill-events-battle-idx": "tsx --env-file=.env scripts/db/apply-kill-events-battle-idx.ts",
    "db:apply-kill-detail-eviction": "tsx --env-file=.env scripts/db/apply-kill-detail-eviction-schema.ts",
    "db:prove-guild-hour-activity": "tsx --env-file=.env scripts/db/prove-guild-hour-activity.ts",
    "db:apply-pending": "npm run db:apply-api-sync-health && npm run db:apply-alliance-battles && npm run db:apply-kill-fame-idx && npm run db:apply-battle-detail-unavailable && npm run db:apply-battle-detail-eviction && npm run db:apply-ops-events && npm run db:apply-api-request-log-details && npm run db:apply-battles-and-participants-idx && npm run db:apply-guild-hour-stats && npm run db:apply-discord-bot && npm run db:apply-kill-events-battle-idx && npm run db:apply-kill-detail-eviction",
    "discord:bot": "tsx --env-file=.env src/discord/start.ts",
    "discord:notify-once": "tsx --env-file=.env scripts/discord-notify-once.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:drift": "node scripts/check-lib-drift.mjs",
    "api": "tsx --env-file=.env src/server.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:reload": "bash deploy/vm/pm2-start-runtime.sh",
    "pm2:startOrReload": "bash deploy/vm/pm2-start-runtime.sh",
    "pm2:resync": "bash deploy/vm/pm2-resync.sh",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "vm:install-redis-watchdog": "bash deploy/vm/install-redis-watchdog.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "bullmq": "^5.34.0",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "postgres": "^3.4.7",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.17.0",
    "pm2": "^5.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
