{
  "name": "ingest",
  "private": true,
  "description": "Background workers and VM maintenance — never deploy to Vercel",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=.env scripts/start.ts",
    "worker": "tsx --env-file=.env src/worker.ts all",
    "worker:process": "tsx --env-file=.env src/worker.ts process",
    "worker:process:loop": "tsx --env-file=.env src/worker.ts process",
    "worker:scheduler": "tsx --env-file=.env src/worker.ts scheduler",
    "worker:scheduler:loop": "tsx --env-file=.env src/worker.ts scheduler",
    "jobs:process": "npm run worker:process",
    "jobs:process:loop": "npm run worker:process:loop",
    "jobs:ingest": "tsx --env-file=.env scripts/run-ingest-once.ts",
    "jobs:ingest:loop": "npm run worker:scheduler:loop",
    "jobs:health": "tsx --env-file=.env scripts/run-health-once.ts",
    "jobs:health:loop": "npm run worker:scheduler:loop",
    "jobs:queue-top-guilds": "tsx --env-file=.env scripts/queue-top-guilds-from-events.ts",
    "db:evict-battle-details": "tsx --env-file=.env scripts/evict-stale-battle-details.ts",
    "db:apply-api-sync-health": "tsx --env-file=.env scripts/db/apply-api-sync-health-schema.ts",
    "db:apply-alliance-battles": "tsx --env-file=.env scripts/db/apply-alliance-battles-schema.ts",
    "db:apply-kill-fame-idx": "tsx --env-file=.env scripts/db/apply-kill-fame-idx.ts",
    "db:apply-battle-detail-unavailable": "tsx --env-file=.env scripts/db/apply-battle-detail-unavailable-schema.ts",
    "db:apply-battle-detail-eviction": "tsx --env-file=.env scripts/db/apply-battle-detail-eviction-schema.ts",
    "db:apply-ops-events": "tsx --env-file=.env scripts/db/apply-ops-events-schema.ts",
    "db:apply-api-request-log-details": "tsx --env-file=.env scripts/db/apply-api-request-log-details-schema.ts",
    "db:apply-pending": "npm run db:apply-api-sync-health && npm run db:apply-alliance-battles && npm run db:apply-kill-fame-idx && npm run db:apply-battle-detail-unavailable && npm run db:apply-battle-detail-eviction && npm run db:apply-ops-events && npm run db:apply-api-request-log-details",
    "api": "tsx --env-file=.env src/server.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.38.3",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "pm2": "^5.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
