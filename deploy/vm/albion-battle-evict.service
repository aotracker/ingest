[Unit]
Description=Albion Kill Tracker — evict stale battle detail JSON
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ingest
EnvironmentFile=/home/ubuntu/ingest/.env
ExecStart=/usr/bin/npm run db:evict-battle-details
Nice=10
TimeoutStartSec=1h

LimitNOFILE=4096
