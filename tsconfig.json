{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@aotracker/core/*": ["./src/lib/*"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
